# Build artifacts — by far the largest source of build-context bloat.
target/
docs/book/

# Version control, CI and deployment files (none are needed to compile)
.git/
.github/
deploy/
.devcontainer/

# Runtime data and secrets
data/
*.parquet
*.duckdb
*.duckdb.wal
admin.json
api_keys.json
.secret
.env
**/.env
*.mmdb
lcov.info

# Node artifacts (not used by the build)
node_modules/
package.json
package-lock.json

# Editor / OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.bak
*.orig
*.log

# The Dockerfile pins the toolchain through the builder image's tag. Leaving
# rust-toolchain.toml out stops rustup from downloading the musl target it lists.
rust-toolchain.toml
